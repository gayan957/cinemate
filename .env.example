# Large language model
GROQ_API_KEY=30ef6cdd-23cc-48b5-b1e8-73b839822aac

# Movie data source
TMDB_API_KEY=b9f525ee721eac56fa722256bd27eca7

# Database - from the Aiven console, Overview tab, Service URI
# The port is NOT 5432, Aiven assigns a random one
# Keep sslmode=require, Aiven refuses unencrypted connections
DATABASE_URL=postgres://avnadmin:PASSWORD@pg-xxxxx.a.aivencloud.com:PORT/defaultdb?sslmode=require

# Optional local database for development
# DATABASE_URL=postgresql://localhost/cinemate

# Security - the SAME value on all four machines
JWT_SECRET=change_this_to_a_long_random_string

# Encryption for stored user preferences - also the SAME on all four
ENCRYPTION_KEY=generate_with_fernet